<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.ArticleBrowseController" 
      style="-fx-background-color: #ffffff;">
    
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
        <Label text="پژوتێ" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Scholarly Publishing Platform" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel" style="-fx-text-fill: white; -fx-font-size: 13px;"/>
    </HBox>
    
    <!-- Search Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
        <TextField fx:id="searchField" promptText="Search articles by keyword, title, or topic..." 
                   HBox.hgrow="ALWAYS" style="-fx-font-size: 14px;"/>
        <Button fx:id="searchButton" text="Search" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"/>
    </HBox>
    
    <!-- Action Buttons -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 15;">
        <Button fx:id="viewArticleButton" text="View Article" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button fx:id="newArticleButton" text="New Article" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        <Button fx:id="myArticlesButton" text="My Articles" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="dashboardButton" text="Admin Dashboard" style="-fx-background-color: #9b59b6; -fx-text-fill: white;"/>
    </HBox>
    
    <!-- Articles Table -->
    <TableView fx:id="articlesTable" VBox.vgrow="ALWAYS" style="-fx-padding: 0 15 15 15;">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="400"/>
            <TableColumn fx:id="authorColumn" text="Author" prefWidth="150"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
            <TableColumn fx:id="publishedColumn" text="Published" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    
    <!-- Footer -->
    <HBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 10;">
        <Label text="Double-click an article to view | Login required for commenting and submissions" 
               style="-fx-text-fill: white; -fx-font-size: 12px;"/>
    </HBox>
    
</VBox>
